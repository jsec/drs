{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices"
    ],
    "timezone": "America/Detroit",
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
            "* * 1-7,15-21 * 6"
        ]
    },
    "customManagers": [
        {
            "description": "dbt packages via GitHub releases; depName hardcoded per package (name uses _, repo uses -).",
            "customType": "regex",
            "managerFilePatterns": [
                "/^etl/dbt/packages\\.yml$/"
            ],
            "matchStrings": [
                "package:\\s+dbt-labs/dbt_utils\\s+version:\\s+[\"']?(?<currentValue>[^\"'\\s]+)"
            ],
            "depNameTemplate": "dbt-labs/dbt-utils",
            "datasourceTemplate": "github-releases"
        }
    ],
    "packageRules": [
        {
            "description": "Run dependency updates on the first and third Saturday every month.",
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch",
                "pin",
                "pinDigest",
                "digest",
                "bump",
                "replacement"
            ],
            "schedule": [
                "* * 1-7,15-21 * 6"
            ]
        },
        {
            "description": "Wait 7 days before patch and minor updates.",
            "matchUpdateTypes": [
                "patch",
                "minor"
            ],
            "minimumReleaseAge": "7 days"
        },
        {
            "description": "Wait 30 days before major updates.",
            "matchUpdateTypes": [
                "major"
            ],
            "minimumReleaseAge": "30 days"
        },
        {
            "description": "Pin web app dependency ranges to exact versions.",
            "matchManagers": [
                "npm"
            ],
            "matchFileNames": [
                "web/package.json"
            ],
            "rangeStrategy": "pin"
        },
        {
            "description": "Keep etl pyproject ranges intact; update uv.lock within the declared caps.",
            "matchManagers": [
                "pep621"
            ],
            "matchFileNames": [
                "etl/pyproject.toml"
            ],
            "rangeStrategy": "update-lockfile"
        },
        {
            "description": "Group non-major Go module updates.",
            "matchManagers": [
                "gomod"
            ],
            "matchUpdateTypes": [
                "patch",
                "minor"
            ],
            "groupName": "go dependencies",
            "groupSlug": "go-dependencies",
            "groupSingleUpdates": true
        },
        {
            "description": "Group non-major web dependency updates.",
            "matchManagers": [
                "npm"
            ],
            "matchFileNames": [
                "web/package.json"
            ],
            "matchUpdateTypes": [
                "patch",
                "minor"
            ],
            "groupName": "web dependencies",
            "groupSlug": "web-dependencies",
            "groupSingleUpdates": true
        },
        {
            "description": "Group non-major etl Python dependency updates.",
            "matchManagers": [
                "pep621"
            ],
            "matchFileNames": [
                "etl/pyproject.toml"
            ],
            "matchUpdateTypes": [
                "patch",
                "minor"
            ],
            "groupName": "etl python dependencies",
            "groupSlug": "etl-python-dependencies",
            "groupSingleUpdates": true
        },
        {
            "description": "Group non-major dbt package updates.",
            "matchDepNames": [
                "dbt-labs/dbt-utils"
            ],
            "matchUpdateTypes": [
                "patch",
                "minor"
            ],
            "groupName": "dbt packages",
            "groupSlug": "dbt-packages",
            "groupSingleUpdates": true
        },
        {
            "description": "Pin Python to 3.13, since dbt doesn't work with 3.14 yet.",
            "matchDepNames": [
                "python"
            ],
            "allowedVersions": "<3.14.0"
        }
    ]
}
